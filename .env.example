# Aplicação
APP_ENV=development
APP_NAME=credit-engine
LOG_LEVEL=INFO
JWT_SECRET_KEY=troque-em-producao-use-key-vault
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=coloque-no-key-vault
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_GPT41=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_GPT41_MINI=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-large
AZURE_OPENAI_MAX_RETRIES=3
AZURE_OPENAI_TIMEOUT_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://credit:credit@postgres:5432/credit_engine

# Redis
REDIS_URL=redis://redis:6379/0
