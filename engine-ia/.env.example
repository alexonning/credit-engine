# ===== App =====
APP_NAME=credit-analysis-engine
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ===== LLM =====
# Se true, usa um stub deterministico (nao chama nenhuma API externa). Util em dev/testes.
LLM_USE_STUB=true
# Provedor usado quando LLM_USE_STUB=false: "azure" ou "anthropic".
LLM_PROVIDER=azure

# ----- Azure OpenAI -----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ----- Anthropic (Claude) - alternativa quando nao for possivel usar a Azure -----
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-opus-4-8

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_engine
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
DATABASE_URL=postgresql+psycopg2://credit:credit@localhost:5432/credit_engine

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ===== Rules =====
RULES_DIR=app/engine/rules
